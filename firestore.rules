rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/farm/{profileId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.updatedAt == request.time
                            && ((profileId == 'selection'
                                  && request.resource.data.keys().hasOnly(['activeFarmId', 'updatedAt'])
                                  && request.resource.data.activeFarmId is string)
                                || (request.resource.data.keys().hasOnly(['profile', 'updatedAt'])
                                    && request.resource.data.profile is map));
      allow delete: if false;
    }
    match /users/{userId}/farms/{farmId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['profile', 'updatedAt'])
                            && request.resource.data.profile is map
                            && request.resource.data.updatedAt == request.time;
    }
    match /users/{userId}/diagnosisHistory/{entryId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly([
                      'crop', 'symptoms', 'diagnosis', 'confidence',
                      'severity', 'actions', 'source', 'createdAt'
                    ])
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.crop is string
                    && request.resource.data.symptoms is string
                    && request.resource.data.diagnosis is string
                    && request.resource.data.severity in ['low', 'medium', 'high']
                    && request.resource.data.actions is list
                    && request.resource.data.actions.size() <= 8
                    && request.resource.data.source is string;
      allow update: if false;
    }
  }
}
